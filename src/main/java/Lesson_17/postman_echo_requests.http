&item[6][name]=Auth: Digest&item[6][item][0][name]=DigestAuth Request&item[6][item][0][event][0][listen]=test&item[6][item][0][event][0][script][type]=text/javascript&item[6][item][0][event][0][script][exec][]=tests["response code is 401"] = responseCode.code === 401;&item[6][item][0][event][0][script][exec][]=tests["response has WWW-Authenticate header"] = (postman.getResponseHeader('WWW-Authenticate'));&item[6][item][0][event][0][script][exec][]=&item[6][item][0][event][0][script][exec][]=var authenticateHeader = postman.getResponseHeader('WWW-Authenticate'),&item[6][item][0][event][0][script][exec][]=    realmStart = authenticateHeader.indexOf('"',authenticateHeader.indexOf("realm")) + 1 ,&item[6][item][0][event][0][script][exec][]=    realmEnd = authenticateHeader.indexOf('"',realmStart),&item[6][item][0][event][0][script][exec][]=    realm = authenticateHeader.slice(realmStart,realmEnd),&item[6][item][0][event][0][script][exec][]=    nonceStart = authenticateHeader.indexOf('"',authenticateHeader.indexOf("nonce")) + 1,&item[6][item][0][event][0][script][exec][]=    nonceEnd = authenticateHeader.indexOf('"',nonceStart),&item[6][item][0][event][0][script][exec][]=    nonce = authenticateHeader.slice(nonceStart,nonceEnd);&item[6][item][0][event][0][script][exec][]=    &item[6][item][0][event][0][script][exec][]=postman.setGlobalVariable('echo_digest_realm', realm);&item[6][item][0][event][0][script][exec][]=postman.setGlobalVariable('echo_digest_nonce', nonce);&item[6][item][0][request][method]=GET&item[6][item][0][request][body][mode]=formdata&item[6][item][0][request][body][formdata][0][key]=code&item[6][item][0][request][body][formdata][0][value]=xWnkliVQJURqB2x1&item[6][item][0][request][body][formdata][0][type]=text&item[6][item][0][request][body][formdata][1][key]=grant_type&item[6][item][0][request][body][formdata][1][value]=authorization_code&item[6][item][0][request][body][formdata][1][type]=text&item[6][item][0][request][body][formdata][2][key]=redirect_uri&item[6][item][0][request][body][formdata][2][value]=https://www.getpostman.com/oauth2/callback&item[6][item][0][request][body][formdata][2][type]=text&item[6][item][0][request][body][formdata][3][key]=client_id&item[6][item][0][request][body][formdata][3][value]=abc123&item[6][item][0][request][body][formdata][3][type]=text&item[6][item][0][request][body][formdata][4][key]=client_secret&item[6][item][0][request][body][formdata][4][value]=ssh-secret&item[6][item][0][request][body][formdata][4][type]=text&item[6][item][0][request][url][raw]=https://postman-echo.com/digest-auth&item[6][item][0][request][url][protocol]=https&item[6][item][0][request][url][host][]=postman-echo&item[6][item][0][request][url][host][]=com&item[6][item][0][request][url][path][]=digest-auth&item[6][item][0][request][description]=Performing a simple `GET` request to this endpoint returns status code `401 Unauthorized` with `WWW-Authenticate` header containing information to successfully authenticate subsequent requests.
The `WWW-Authenticate` header must be processed to extract `realm` and `nonce` values to hash subsequent requests.

When this request is executed within Postman, the script attached with this request does the hard work of extracting realm and nonce from the header and set it as [global variables](https://www.getpostman.com/docs/environments#global-variables?source=echo-collection-app-onboarding) named `echo_digest_nonce` and `echo_digest_realm`.
These variables are re-used in subsequent request for seamless integration of the two requests.&item[6][description]=Digest authentication protects an endpoint with a username and password without actually transmitting the password over network.
One has to apply a hash function (like MD5, etc) to the username and password before sending them over the network.

> Username: `postman`
>
> Password: `password`

Unlike Basic-Auth, authentication happens using two consecutive requests where the first request returns `401 Unauthorised` along with `WWW-Authenticate` header containing information that needs to be used to authenticate subsequent calls.

To know more about digest authentication, refer to the [Digest Access Authentication](https://en.wikipedia.org/wiki/Digest_access_authentication) wikipedia article.
The article on [authentication helpers](https://www.getpostman.com/docs/helpers#digest-auth) elaborates how to use the same within the Postman app.d to be sent back as part of response body.