zVu8CRaD.GOV1H9olcVzXqrwqP%2BC%2B6MVj2UczXivcN00jgPoDYfs&item[4][item][0][response][0][cookie][3][key]=sails.sid&item[4][item][0][response][0][body]={"status":200}&item[4][item][1][name]=Streamed Response&item[4][item][1][event][0][listen]=test&item[4][item][1][event][0][script][type]=text/javascript&item[4][item][1][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][1][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][1][event][0][script][exec][]=});&item[4][item][1][event][0][script][exec][]=&item[4][item][1][event][0][script][exec][]=pm.test("response has chunked transfer encoding header", function () {&item[4][item][1][event][0][script][exec][]=    pm.response.to.have.header('transfer-encoding', 'chunked');&item[4][item][1][event][0][script][exec][]=});&item[4][item][1][request][method]=GET&item[4][item][1][request][body][mode]=formdata&item[4][item][1][request][url][raw]=https://postman-echo.com/stream/5&item[4][item][1][request][url][protocol]=https&item[4][item][1][request][url][host][]=postman-echo&item[4][item][1][request][url][host][]=com&item[4][item][1][request][url][path][]=stream&item[4][item][1][request][url][path][]=5&item[4][item][1][request][description]=This endpoint allows one to recieve streaming http response using [chunked transfer encoding](https://en.wikipedia.org/wiki/Chunked_transfer_encoding) of a configurable length.

A streaming response does not wait for the entire response to be generated on server before flushing it out. This implies that for a fairly large response, parts of it can be streamed to the requestee as and when it is generated on server. The client can then take actions of processing this partially received data.&item[4][item][2][name]=Delay Response&item[4][item][2][event][0][listen]=test&item[4][item][2][event][0][script][type]=text/javascript&item[4][item][2][event][0][script][exec][]=var _ = require('lodash');&item[4][item][2][event][0][script][exec][]=&item[4][item][2][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][2][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][2][event][0][script][exec][]=});&item[4][item][2][event][0][script][exec][]=&item[4][item][2][event][0][script][exec][]=pm.test("response has valid json body", function () {&item[4][item][2][event][0][script][exec][]=    pm.response.to.have.jsonBody('delay');&item[4][item][2][event][0][script][exec][]=});&item[4][item][2][event][0][script][exec][]=&item[4][item][2][event][0][script][exec][]=// additional sanity tests&item[4][item][2][event][0][script][exec][]=pm.test("request must have a valid delay", function () {&item[4][item][2][event][0][script][exec][]=    pm.expect(Number(_.get(pm.request, 'url.path[1]'))).to.be.above(0).and.below(10);&item[4][item][2][event][0][script][exec][]=});&item[4][item][2][event][0][script][exec][]=pm.test("response should take more time than the delay specified", function () {&item[4][item][2][event][0][script][exec][]=    pm.expect(pm.response.responseTime).to.be.above(Number(_.get(pm.request, 'url.path[1]')));&item[4][item][2][event][0][script][exec][]=});&item[4][item][2][request][method]=GET&item[4][item][2][request][body][mode]=formdata&item[4][item][2][request][url][raw]=https://postman-echo.com/delay/2&item[4][item][2][request][url][protocol]=https&item[4][item][2][request][url][host][]=postman-echo&item[4][item][2][request][url][host][]=com&item[4][item][2][request][url][path][]=delay&item[4][item][2][request][url][path][]=2&item[4][item][2][request][description]=Using this endpoint one can configure how long it takes for the server to come back with a response. Appending a number to the URL defines the time (in seconds) the server will wait before responding.

Note that a maximum delay of 10 seconds is accepted by the server.&item[4][item][2][response][0][name]=success-response&item[4][item][2][response][0][originalRequest][method]=GET&item[4][item][2][response][0][originalRequest][body][mode]=formdata&item[4][item][2][response][0][originalRequest][url][raw]=https://echo.getpostman.com/delay/3&item[4][item][2][response][0][originalRequest][url][protocol]=https&item[4][item][2][response][0][originalRequest][url][host][]=echo&item[4][item][2][response][0][originalRequest][url][host][]=getpostman&item[4][item][2][response][0][originalRequest][url][host][]=com&item[4][item][2][response][0][originalRequest][url][path][]=delay&item[4][item][2][response][0][originalRequest][url][path][]=3&item[4][item][2][response][0][status]=OK&item[4][item][2][response][0][code]=200&item[4][item][2][response][0][_postman_previewlanguage]=json&item[4][item][2][response][0][header][0][key]=Access-Control-Allow-Credentials&item[4][item][2][response][0][header][0][value]=&item[4][item][2][response][0][header][0][name]=Access-Control-Allow-Credentials&item[4][item][2][response][0][header][0][description]=&item[4][item][2][response][0][header][1][key]=Access-Control-Allow-Headers&item[4][item][2][response][0][header][1][value]=&item[4][item][2][response][0][header][1][name]=Access-Control-Allow-Headers&item[4][item][2][response][0][header][1][description]=&item[4][item][2][response][0][header][2][key]=Access-Control-Allow-Methods&item[4][item][2][response][0][header][2][value]=&item[4][item][2][response][0][header][2][name]=Access-Control-Allow-Methods&item[4][item][2][response][0][header][2][description]=&item[4][item][2][response][0][header][3][key]=Access-Control-Allow-Origin&item[4][item][2][response][0][header][3][value]=&item[4][item][2][response][0][header][3][name]=Access-Control-Allow-Origin&item[4][item][2][response][0][header][3][description]=&item[4][item][2][response][0][header][4][key]=Access-Control-Expose-Headers&item[4][item][2][response][0][header][4][value]=&item[4][item][2][response][0][header][4][name]=Access-Control-Expose-Headers&item[4][item][2][response][0][header][4][description]=&item[4][item][2][response][0][header][5][key]=Connection&item[4][item][2][response][0][header][5][value]=keep-alive&item[4][item][2][response][0][header][5][name]=Connection&item[4][item][2][response][0][header][5][description]=&item[4][item][2][response][0][header][6][key]=Content-Length&item[4][item][2][response][0][header][6][value]=13&item[4][item][2][response][0][header][6][name]=Content-Length&item[4][item][2][response][0][header][6][description]=&item[4][item][2][response][0][header][7][key]=Content-Type&item[4][item][2][response][0][header][7][value]=application/json; charset=utf-8&item[4][item][2][response][0][header][7][name]=Content-Type&item[4][item][2][response][0][header][7][description]=&item[4][item][2][response][0][header][8][key]=Date&item[4][item][2][response][0][header][8][value]=Mon, 02 Jan 2017 09:19:03 GMT&item[4][item][2][response][0][header][8][name]=Date&item[4][item][2][response][0][header][8][description]=&item[4][item][2][response][0][header][9][key]=ETag&item[4][item][2][response][0][header][9][value]=W/"d-t/L/D5c0SDl+MoXtKdSVOg"&item[4][item][2][response][0][header][9][name]=ETag&item[4][item][2][response][0][header][9][description]=&item[4][item][2][response][0][header][10][key]=Server&item[4][item][2][response][0][header][10][value]=nginx/1.10.1&item[4][item][2][response][0][header][10][name]=Server&item[4][item][2][response][0][header][10][description]=&item[4][item][2][response][0][header][11][key]=Vary&item[4][item][2][response][0][header][11][value]=Accept-Encoding&item[4][item][2][response][0][header][11][name]=Vary&item[4][item][2][response][0][header][11][description]=&item[4][item][2][response][0][cookie][0][expires]=Tue Jan 19 2038 00:44:07 GMT+0300 (Москва, стандартное время)&item[4][item][2][response][0][cookie][0][httpOnly]=true&item[4][item][2][response][0][cookie][0][domain]=echo.getpostman.com&item[4][item][2][response][0][cookie][0][path]=/&item[4][item][2][response][0][cookie][0][secure]=false&item[4][item][2][response][0][cookie][0][value]=s%3AYjUiFBtGiJVL2a-qzZQZ1DFlAMhgXN9O.WaAjRUV0OteZxwmhbNibuB7VKse068JJIh6PwLQUKmQ&item[4][item][2][response][0][cookie][0][key]=sails.sid&item[4][item][2][response][0][body]={"delay":"3"}&item[4][item][3][name]=Get UTF8 Encoded Response&item[4][item][3][event][0][listen]=test&item[4][item][3][event][0][script][type]=text/javascript&item[4][item][3][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][3][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][3][event][0][script][exec][]=});&item[4][item][3][event][0][script][exec][]=&item[4][item][3][event][0][script][exec][]=pm.test("response has charset in content-type header", function () {&item[4][item][3][event][0][script][exec][]=    pm.response.to.have.header('content-type', 'text/html; charset=utf-8');&item[4][item][3][event][0][script][exec][]=});&item[4][item][3][event][0][script][exec][]=&item[4][item][3][event][0][script][exec][]=pm.test("response has chunked transfer encoding header", function () {&item[4][item][3][event][0][script][exec][]=    pm.response.to.have.header('transfer-encoding', 'chunked');&item[4][item][3][event][0][script][exec][]=});&item[4][item][3][request][method]=GET&item[4][item][3][request][body][mode]=formdata&item[4][item][3][request][url][raw]=https://postman-echo.com/encoding/utf8&item[4][item][3][request][url][protocol]=https&item[4][item][3][request][url][host][]=postman-echo&item[4][item][3][request][url][host][]=com&item[4][item][3][request][url][path][]=encoding&item[4][item][3][request][url][path][]=utf8&item[4][item][3][request][description]=If a response of an endpoint requires to send data beyond the basic English / ASCII character set, the `charset` parameter in the `Content-Type` response header defines the character encoding policy.

This endpoint returns an `UTF8` character encoded response body with text in various languages such as Greek, Latin, East Asian, etc. Postman can interpret the character encoding and use appropriate methods to display the character set in responses.&item[4][item][4][name]=GZip Compressed Response&item[4][item][4][event][0][listen]=test&item[4][item][4][event][0][script][type]=text/javascript&item[4][item][4][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][4][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][4][event][0][script][exec][]=});&item[4][item][4][event][0][script][exec][]=&item[4][item][4][event][0][script][exec][]=pm.test("response has valid json body", function () {&item[4][item][4][event][0][script][exec][]=    pm.response.to.have.jsonBody('gzipped', true);&item[4][item][4][event][0][script][exec][]=});&item[4][item][4][event][0][script][exec][]=&item[4][item][4][event][0][script][exec][]=pm.test('response headers should indicate valid content encoding', function  () {&item[4][item][4][event][0][script][exec][]=    pm.response.to.have.header('content-encoding', 'gzip')&item[4][item][4][event][0][script][exec][]=        .and.have.header('content-type', 'application/json');&item[4][item][4][event][0][script][exec][]=});&item[4][item][4][event][0][script][exec][]=&item[4][item][4][event][0][script][exec][]=pm.test('requesting http client should accept compressed response', function () {&item[4][item][4][event][0][script][exec][]=    pm.expect(pm.response.json()).to.have.nested.property('headers.accept-encoding')&item[4][item][4][event][0][script][exec][]=        .and.to.match(/.*gzip.*/);&item[4][item][4][event][0][script][exec][]=});&item[4][item][4][request][method]=GET&item[4][item][4][request][body][mode]=formdata&item[4][item][4][request][url][raw]=https://postman-echo.com/gzip&item[4][item][4][request][url][protocol]=https&item[4][item][4][request][url][host][]=postman-echo&item[4][item][4][request][url][host][]=com&item[4][item][4][request][url][path][]=gzip&item[4][item][4][request][description]=This endpoint returns the response using [gzip compression algoritm](https://en.wikipedia.org/wiki/Gzip).
The uncompressed response is a JSON string containing the details of the request sent by the client. For this endpoint to work, one should request with `Accept-encoding` header containing `gzip` as part of its value. Postman supports gzip, deflate and SDCH decoding and automatically sends them as part of the request.

HTTP Compression allows the server to send responses in a compressed format, which is uncompressed by the client before processing. This reduces network bandwidth consumption at the cost of increase in CPU usage.
To know more about this, refer the [HTTP Compression](https://en.wikipedia.org/wiki/HTTP_compression) wikipedia article.&item[4][item][5][name]=Deflate Compressed Response&item[4][item][5][event][0][listen]=test&item[4][item][5][event][0][script][type]=text/javascript&item[4][item][5][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][5][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][5][event][0][script][exec][]=});&item[4][item][5][event][0][script][exec][]=&item[4][item][5][event][0][script][exec][]=pm.test("response has valid json body", function () {&item[4][item][5][event][0][script][exec][]=    pm.response.to.have.jsonBody('deflated', true);&item[4][item][5][event][0][script][exec][]=});&item[4][item][5][event][0][script][exec][]=&item[4][item][5][event][0][script][exec][]=pm.test('response headers should indicate valid content encoding', function  () {&item[4][item][5][event][0][script][exec][]=    pm.response.to.have.header('content-encoding', 'deflate')&item[4][item][5][event][0][script][exec][]=        .and.have.header('content-type', 'application/json');&item[4][item][5][event][0][script][exec][]=});&item[4][item][5][event][0][script][exec][]=&item[4][item][5][event][0][script][exec][]=pm.test('requesting http client should accept compressed response', function () {&item[4][item][5][event][0][script][exec][]=    pm.expect(pm.response.json()).to.have.nested.property('headers.accept-encoding')&item[4][item][5][event][0][script][exec][]=        .and.to.match(/.*deflate.*/);&item[4][item][5][event][0][script][exec][]=});&item[4][item][5][request][method]=GET&item[4][item][5][request][body][mode]=formdata&item[4][item][5][request][url][raw]=https://postman-echo.com/deflate&item[4][item][5][request][url][protocol]=https&item[4][item][5][request][url][host][]=postman-echo&item[4][item][5][request][url][host][]=com&item[4][item][5][request][url][path][]=deflate&item[4][item][5][request][description]=This endpoint returns the response using [deflate compression algoritm](https://en.wikipedia.org/wiki/DEFLATE).
The uncompressed response is a JSON string containing the details of the request sent by the client. For this endpoint to work, one should request with `Accept-encoding` header containing `deflate` as part of its value. Postman supports gzip, deflate and SDCH decoding and automatically sends them as part of the request.

HTTP Compression allows the server to send responses in a compressed format, which is uncompressed by the client before processing. This reduces network bandwidth consumption at the cost of increase in CPU usage.
To know more about this, refer the [HTTP Compression](https://en.wikipedia.org/wiki/HTTP_compression) wikipedia article.&item[4][item][6][name]=IP address in JSON format&item[4][item][6][event][0][listen]=test&item[4][item][6][event][0][script][type]=text/javascript&item[4][item][6][event][0][script][exec][]=pm.test("response is ok", function () {&item[4][item][6][event][0][script][exec][]=    pm.response.to.have.status(200);&item[4][item][6][event][0][script][exec][]=});&item[4][item][6][event][0][script][exec][]=&item[4][item][6][event][0][script][exec][]=pm.test("response has valid json body", function () {&item[4][item][6][event][0][script][exec][]=    pm.response.to.have.jsonBody('ip');&item[4][item][6][event][0][script][exec][]=});&item[4][item][6][event][0][script][exec][]=&item[4][item][6][event][0][script][exec][]=pm.test("response must return a valid ip address", function () {&item[4][item][6][event][0][script][exec][]=    pm.expect(pm.response.json().ip).to&item[4][item][6][event][0][script][exec][]=        // a really gnarly regular expression to ensure that ip address is in correct format&item[4][item][6][event][0][script][exec][]=        .match(/^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/);&item[4][item][6][event][0][script][exec][]=});&item[4][item][6][request][method]=GET&item[4][item][6][request][body][mode]=formdata&item[4][item][6][request][url][raw]=https://postman-echo.com/ip&item[4][item][6][request][url][protocol]=https&item[4][item][6][request][url][host][]=postman-echo&item[4][item][6][request][url][host][]=com&item[4][item][6][request][url][path][]=ip&item[4][item][6][request][description]=A simple `GET` request to return the IP address of the source request in the following `JSON` format:

```json
{
  ip: "request-ip-address"
}
```&item[5][name]=Utilities / Date and Time&item[5][item][0][name]=Current UTC time&item[5][item][0][event][0][listen]=test&item[5][item][0][event][0][script][type]=text/javascript&item[5][item][0][event][0][script][exec][]=pm.test("response is ok", function () {&item[5][item][0][event][0][script][exec][]=    pm.response.to.have.status(200);&item[5][item][0][event][0][script][exec][]=});&item[5][item][0][event][0][script][exec][]=&item[5][item][0][event][0][script][exec][]=pm.test("response time matches server response 'date' header", function () {&item[5][item][0][event][0][script][exec][]=    pm.expect(pm.response.text()).to.eql(pm.response.headers.get('date'))&item[5][item][0][event][0][script][exec][]=});&item[5][item][0][request][method]=GET&item[5][item][0][request][body][mode]=formdata&item[5][item][0][request][url][raw]=https://postman-echo.com/time/now&item[5][item][0][request][url][protocol]=https&item[5][item][0][request][url][host][]=postman-echo&item[5][item][0][request][url][host][]=com&item[5][item][0][request][url][path][]=time&item[5][item][0][request][url][path][]=now&item[5][item][0][request][description]=A simple `GET` request to `/time/now` to return the current timestamp as a UTC string.

